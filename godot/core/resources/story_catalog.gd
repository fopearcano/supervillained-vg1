class_name StoryCatalog
extends Resource
## The campaign's scene catalog as data: level numbers and titles, sub-level ids and titles, and
## which sub-level is the Green Zone walk. Generated by tools/build_resources.gd from two sources:
## - the frozen compatibility catalog `data/campaign/story_catalog.json` (extracted from the source
##   CHAPTERS by tools/source_extract): the stable IDs, the eight chapters, the 37-entry order, the
##   Green Zone dispatch, and draft fallback titles for chapters not rewritten yet;
## - the Godot story Resources (`data/story/`, the narrative authority, M5R): every rewritten
##   chapter's title and menu title and every rewritten scene's title override the fallback.
## The title screen, CONTINUE, the Couch, the level and chapter lists and the boundary card read it;
## scene cards read the scene Resource itself. IDs and save compatibility never change here.

## [{"number": int, "title": String, "menu_title": String,
##   "sub_levels": [{"id": String, "title": String, "green_zone": int (0 = a story scene)}]}]
@export var chapters: Array = []


func ids() -> PackedStringArray:
	var out := PackedStringArray()
	for ch: Dictionary in chapters:
		for s: Dictionary in ch["sub_levels"]:
			out.append(String(s["id"]))
	return out


func has_id(id: String) -> bool:
	return ids().has(id)


func chapter(number: int) -> Dictionary:
	for ch: Dictionary in chapters:
		if int(ch["number"]) == number:
			return ch
	return {}


## {"chapter": Dictionary, "index": int, "sub": Dictionary} or {} (source findSubLevel).
func find(id: String) -> Dictionary:
	for ch: Dictionary in chapters:
		var subs: Array = ch["sub_levels"]
		for k in subs.size():
			if subs[k]["id"] == id:
				return {"chapter": ch, "index": k, "sub": subs[k]}
	return {}


## The first unfinished sub-level in story order: {"level", "id", "title"}, or {} when finished.
func next_unfinished(completed: Array) -> Dictionary:
	for ch: Dictionary in chapters:
		for s: Dictionary in ch["sub_levels"]:
			if not completed.has(s["id"]):
				return {"level": int(ch["number"]), "id": String(s["id"]), "title": String(s["title"])}
	return {}


## Where CONTINUE goes (source StoryFlow.nextLabel): "LEVEL 1: 1.0 THE GREEN ZONE", or "".
func continue_label(completed: Array) -> String:
	var n := next_unfinished(completed)
	if n.is_empty():
		return ""
	return "LEVEL %d: %s %s" % [n["level"], n["id"], String(n["title"]).to_upper()]


## The sub-level is playable in this build: the Green Zone walk, or a story scene whose rewritten
## Resource exists (data/story/scenes/<id>.tres, M5R); the others show the "not in this build" card.
func playable_in_build(id: String) -> bool:
	var f := find(id)
	if f.is_empty():
		return false
	return int(f["sub"]["green_zone"]) > 0 or ResourceLoader.exists(scene_path(id))


## Where a story scene's Resource lives.
static func scene_path(id: String) -> String:
	return "res://data/story/scenes/%s.tres" % id.replace(".", "_")


# --- Generation (tools/build_resources.gd and the tests; never at run time) ----------------------

## The rewrite's display titles, read from the story Resources under `root` (text resources) without
## loading their scripts — the build tool runs before the autoloads exist:
## {"chapters": {number: {"title", "menu_title"}}, "scenes": {id: title}}.
static func rewrite_titles(root: String = "res://data/story") -> Dictionary:
	var out := {"chapters": {}, "scenes": {}}
	var ch_dir := root.path_join("chapters")
	if DirAccess.dir_exists_absolute(ch_dir):
		for f in DirAccess.get_files_at(ch_dir):
			if f.ends_with(".tres"):
				var r := resource_fields(ch_dir.path_join(f))
				if r.has("number"):
					out["chapters"][int(r["number"])] = {"title": String(r.get("title", "")), "menu_title": String(r.get("menu_title", ""))}
	var sc_dir := root.path_join("scenes")
	if DirAccess.dir_exists_absolute(sc_dir):
		for f in DirAccess.get_files_at(sc_dir):
			if f.ends_with(".tres"):
				var r := resource_fields(sc_dir.path_join(f))
				if r.has("id"):
					out["scenes"][String(r["id"])] = String(r.get("title", ""))
	return out


## The one-line fields id, number, title and menu_title of a text resource's [resource] section.
static func resource_fields(path: String) -> Dictionary:
	var out := {}
	var text := FileAccess.get_file_as_string(path).replace("\r\n", "\n")
	var at := text.find("\n[resource]\n")
	if at < 0:
		return out
	for line in text.substr(at + 12).split("\n"):
		if line.begins_with("["):
			break
		var eq := line.find(" = ")
		if eq > 0 and ["id", "number", "title", "menu_title"].has(line.substr(0, eq)):
			out[line.substr(0, eq)] = str_to_var(line.substr(eq + 3))
	return out


## The catalog chapters: the compatibility catalog's IDs, order and Green Zone dispatch, with the
## rewrite's titles over the draft titles wherever a Resource gives one.
static func overlay(compat: Dictionary, titles: Dictionary) -> Array:
	var out: Array = []
	for ch: Dictionary in compat["chapters"]:
		var n := int(ch["number"])
		var rw: Dictionary = (titles["chapters"] as Dictionary).get(n, {})
		var subs: Array = []
		for sub: Dictionary in ch["subLevels"]:
			var id := String(sub["id"])
			var t := String((titles["scenes"] as Dictionary).get(id, ""))
			subs.append({"id": id, "title": t if t != "" else String(sub["title"]), "green_zone": int(sub["greenZone"])})
		var ct := String(rw.get("title", ""))
		var cm := String(rw.get("menu_title", ""))
		out.append({"number": n, "title": ct if ct != "" else String(ch["title"]), "menu_title": cm if cm != "" else String(ch["menuTitle"]), "sub_levels": subs})
	return out
