; Engine configuration file for the SUPERVILLAINED VG1 Godot port.
; The PixiJS/TypeScript game in the repository root is untouched; this project lives in /godot.

config_version=5

[application]

config/name="SUPERVILLAINED VG1"
config/description="Godot 4.7 port of SUPERVILLAINED VG1 (Green Zone vertical slice)."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://assets/branding/icon.png"
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://data/audio/default_bus_layout.tres"

[autoload]

SaveService="*res://autoload/save_service.gd"
AppState="*res://autoload/app_state.gd"
InputService="*res://autoload/input_service.gd"
AudioService="*res://autoload/audio_service.gd"

[display]

window/size/viewport_width=432
window/size/viewport_height=864
window/stretch/mode="disabled"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/swappy_mode=0
window/energy_saving/keep_screen_on=true

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":75)]
}
pee={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
action={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventKey,"physical_keycode":88)]
}
bark={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":80)]
}
confirm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":4194310)]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
