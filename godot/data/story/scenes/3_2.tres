speaker = "marshal"
text = "I SIGNED IT MYSELF: FOUR MARKS A HORSE, TWO A MAN, FOOD FOR NINE MONTHS. EIGHTY-FIVE THOUSAND MARKS. WE PROMISED THAT THE WHOLE ARMY WOULD COME."
remembered = false
effects = {}

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("4_dialoguestep")
id = "s03"
speaker = "marshal"
text = "A MARK IS NOT A COIN, LITTLE KNIGHT. IT IS A WEIGHT OF SILVER. AND WHATEVER WE WIN WE SHARE HALF AND HALF WITH VENICE, FOR AS LONG AS OUR COMPANY LASTS."
remembered = false
effects = {}

