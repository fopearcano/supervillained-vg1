[resource]
script = ExtResource("1_storyscenedata")
id = "3.2"
content_version = 1
title = "The price of passage"
old_title = "The price of passage"
level = 3
summary = "THE MARSHAL EXPLAINS THE CONTRACT HE SIGNED: SO MUCH A HORSE, SO MUCH A MAN, EIGHTY-FIVE THOUSAND MARKS. CARRY THE COLLECTING BOWL ROUND THE CAMP TWICE: THE PILGRIMS PAY THEIR FARES, THEN THE GREAT LORDS GIVE UP THEIR PLATE. ZAMPANO KEEPS CLARI'S COUNT; THE MARSHAL KEEPS HIS OWN. THEY DO NOT AGREE."
map = "lido"
music = "level3"
cast = PackedStringArray("zampano", "marshal")
steps = [SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29"), SubResource("Resource_30")]
entry_conditions = {
"requires_completed": ["3.1"]
}
persistent_effects = PackedStringArray("flags.shortfall", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["shortfall"]
}
reality = false
historical_tags = PackedStringArray("dream", "the Lido, 1202", "the treaty of 1201: 85,000 marks", "the collections", "two counts kept apart: 34,000 (Villehardouin) and 36,000 (Clari)")
source_refs = PackedStringArray("Villehardouin pp. 6-7 (the treaty: 4 marks a horse, 2 a man, 85,000 marks)", "Villehardouin pp. 15-16 (more than half missing; the rich give their plate; 34,000 still owed)", "Clari XI-XII (Munro): 50,000 still due after the first collection, 36,000 after the second", "docs/STORY-SOURCES.md \"Kept disagreements\" and \"Period words\": A WEIGHT OF SILVER, OUR COMPANY", "docs/STORY.md 3.2", "src/campaign/chapters/ch3.ts 3.2 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "Both counts are kept and never merged: the marshal says 34,000 (Villehardouin); Zampano keeps Clari's 50,000 then 36,000; the campaign's `shortfall` is Clari's 36,000.", "The bowl carried round the tents is adaptation.")
technical_status = "technically_complete"
