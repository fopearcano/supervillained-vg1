[resource]
script = ExtResource("1_storyscenedata")
id = "5.1"
content_version = 1
title = "A small favor for Venice"
old_title = "A small favor for Venice"
level = 5
summary = "AN ABBOT READS OUT THE POPE'S PROHIBITION: THE PEOPLE OF ZARA ARE CHRISTIANS. THE DOGE WILL NOT HEAR OF STOPPING. CARRY MESSAGES BETWEEN TWO GROUPS ON THE QUAY: ONE TOOK THE CROSS FOR JERUSALEM, NOT FOR THIS; THE OTHER SAYS THE HOST FALLS APART UNLESS IT HELPS THE DOGE. THEN SAY ONE OF THEM ALOUD. THE MARSHAL REMEMBERS WHO SPOKE AGAINST HIM."
map = "zara"
music = "medieval"
cast = PackedStringArray("zampano", "abbot", "doge", "knight", "marshal")
steps = [SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29")]
entry_conditions = {
"requires_completed": ["4.3"]
}
persistent_effects = PackedStringArray("meter.standing", "meter.supervillain", "meter.grace", "meter.commozione", "flags.dissent", "book.remembered")
completion = {
"boundary": "scene"
}
reality = false
historical_tags = PackedStringArray("dream", "Zara, November 1202", "the abbot of Vaux's prohibition", "the host divided")
source_refs = PackedStringArray("Villehardouin pp. 20-21: the abbot of Vaux forbids the attack \"on the part of the Pope of Rome\" (quoted per docs/STORY-SOURCES.md); the party that wanted the host broken up; the barons persist", "Clari 14: Zara has a letter from Rome threatening excommunication; the Doge will not refrain", "docs/STORY.md 5.1", "src/campaign/chapters/ch5.ts 5.1 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The messenger role is adaptation; the abbot's line paraphrases the prohibition (no papal words are quoted).", "The dissent route costs 10 Commozione (an unmoved Zampano cannot speak up) and sets `dissent`; the host route does not.")
technical_status = "technically_complete"
