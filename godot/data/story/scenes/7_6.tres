[resource]
script = ExtResource("1_storyscenedata")
id = "7.6"
content_version = 1
title = "A third Alexios"
old_title = "A third Alexios"
level = 7
summary = "THE MARSHAL IS ONE OF THE ENVOYS WHO CARRY THE DEFIANCE TO THE PALACE: WALK IN WITH THEM, HEAR IT, AND WALK OUT AT THE SAME PACE. ENVOYS DO NOT RUN. FIRE-SHIPS COME DOWN ON THE FLEET AT NIGHT. THEN MOURTZOUPHLOS TAKES THE THRONE AS ALEXIOS V, AND THE YOUNG ALEXIOS IV DIES: THE TWO BOOKS DO NOT AGREE HOW. THE DREAM RUNS OUT OF FACES: BAGNASKIZ AGAIN, UNDER A DIFFERENT CROWN."
map = "palace"
music = "medieval"
cast = PackedStringArray("zampano", "marshal", "prince", "emperor")
steps = [SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27")]
entry_conditions = {
"requires_completed": ["7.5"]
}
persistent_effects = PackedStringArray("book.remembered")
completion = {
"boundary": "scene"
}
reality = false
historical_tags = PackedStringArray("dream", "the defiance, winter 1203-1204", "the fire-ships", "Mourtzouphlos, Alexios V", "the deaths of Alexios IV and Isaac II, in two accounts")
source_refs = PackedStringArray("Villehardouin pp. 53-56: the defiance delivered at Blachernae (Conon of Bethune, Geoffroi de Villehardouin, Miles of Brabant, three Venetians); the fire-ships; Mourtzouphlos seizes power; Alexios IV strangled; Isaac dies", "Clari 61-62: Mourtzouphlos has both strangled (his version)", "docs/STORY.md 7.6", "src/campaign/chapters/ch7.ts 7.6 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The walking rule is adaptation: running is possible and stops the walk (YOU RAN).", "The marshal's defiance is a paraphrase, not a quotation.", "REVIEW REQUIRED: the deaths of Alexios IV and Isaac II. The two accounts are kept apart as the draft reference gives them (Villehardouin pp. 53-56: Alexios IV strangled, Isaac dies; Clari 61-62: Mourtzouphlos has both strangled); page references and the dating (the draft says January 1204; Mourtzouphlos was crowned in early February) to be checked against the editions.")
technical_status = "technically_complete"
