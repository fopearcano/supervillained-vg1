source_refs = PackedStringArray("Clari 40-41 (De Re Militari): the people watch from the walls and rooftops; the crews look on the city with wonder; ten galleys show the young man and the city will not know him", "Villehardouin pp. 35-36: the same showing", "docs/STORY-SOURCES.md \"Period words\": THOSE OF THE WEST, LATINS, BARBARIANS; ROMANS; THE YEAR 6711", "docs/STORY.md 7.1", "src/campaign/chapters/ch7.ts 7.1 (draft reference)")
