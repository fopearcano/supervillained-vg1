[resource]
script = ExtResource("1_storyscenedata")
id = "7.9"
content_version = 1
title = "The common pile"
old_title = "The common pile"
level = 7
summary = "THE LAMP FROM NIKETAS'S COURTYARD IS LYING IN THE STREET. BRING IT TO THE COMMON PILE, AS SWORN, OR KEEP IT UNDER YOUR CLOAK. ON THE WAY THE BRONZE HERCULES IS GONE FROM ITS PEDESTAL, AND THE CARVED COLUMN NOW SEEMS TO SAY WHAT EVERYONE KNEW ALL ALONG. AT THE PILE THE GOLD AND SILK STAY UNDER GUARD, AND THE POOR KNIGHTS GET THE COARSE SILVER. JERUSALEM IS LOADING."
map = "city"
music = "medieval"
cast = PackedStringArray("zampano", "confusione")
steps = [SubResource("Resource_2"), SubResource("Resource_4"), SubResource("Resource_11"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29")]
entry_conditions = {
"requires_completed": ["7.8"]
}
persistent_effects = PackedStringArray("meter.grace", "flags.lamp", "book.values", "coins", "book.marvels", "meter.commozione", "flags.columnAgain", "book.remembered")
completion = {
"boundary": "chapter_end",
"requires_flags": ["lamp"]
}
reality = false
historical_tags = PackedStringArray("dream", "after the sack, April 1204", "the common pile", "things kept back", "statues melted for coin", "Jerusalem never reached")
source_refs = PackedStringArray("Clari 81 (the treasure guarded; the poor knights get only the coarse silver), 92 (the pillars, read after the event), 98 (Aleaume claims a knight's share; Saint-Pol allows it), 105", "Villehardouin pp. 65-66: covetousness; things kept back; the count of Saint-Pol hangs a knight with his shield at his neck", "Choniates, destroyed monuments (paras. 2-3): bronze statues melted into coin; the Hercules thrown down", "docs/STORY.md 7.9", "src/campaign/chapters/ch7.ts 7.9 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The lamp and the choice are adaptation. The column is an inscription read after the fact, not a prophecy machine.", "LI RIKE HOMME / LI POVRE CHEVALIER: Clari's Old French terms as the draft gives them; spelling REVIEW REQUIRED.")
technical_status = "technically_complete"
