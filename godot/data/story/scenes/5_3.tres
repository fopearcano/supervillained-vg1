[resource]
script = ExtResource("1_storyscenedata")
id = "5.3"
content_version = 1
title = "Whose orders?"
old_title = "Whose orders?"
level = 5
summary = "INSIDE THE CITY, VENETIANS AND PILGRIMS FIGHT IN THE STREETS ALL NIGHT. ON THE WAY HEAR WHAT THREE PEOPLE SAY HE OWES: THE ABBOT, THE MARSHAL AND A VENETIAN. ALEAUME WANTS TO KNOW WHICH OF THEM HE BELIEVES. THEN GET BACK TO THEIR QUARTERS THROUGH THE BRAWL: BARK OR SHIELD THE BRAWLERS ASIDE. THE POPE FORBADE THEM TO ATTACK CHRISTIANS, AND EVERY SWORD BLOW THAT LANDS COSTS GRACE."
map = "zara"
music = "medieval"
cast = PackedStringArray("zampano", "confusione")
steps = [SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_15"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29")]
entry_conditions = {
"requires_completed": ["5.2"]
}
persistent_effects = PackedStringArray("meter.grace", "meter.standing", "meter.supervillain", "flags.zaraOwe", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["zaraOwe"]
}
reality = false
historical_tags = PackedStringArray("dream", "Zara, inside the walls", "the fray between Venetians and Franks", "three debts")
source_refs = PackedStringArray("Villehardouin p. 22 (a fray between Venetians and Franks; peace after a week) and pp. 20-21", "Clari 15: a great contention between the Venetians and the lesser pilgrims, a night and half a day", "docs/STORY.md 5.3", "src/campaign/chapters/ch5.ts 5.3 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The three speeches, the choice, the walk through the brawl and the Grace the sword costs are adaptation.", "The brawl only has to be crossed (no one need be routed); every sword swing that lands costs Grace -1 (bark, shield, misses and parried blows cost nothing).")
technical_status = "technically_complete"
