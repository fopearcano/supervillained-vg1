"requires_flags": ["vanguard"]
}
reality = false
historical_tags = PackedStringArray("dream", "the battle that was not, July 1203", "Pierre d'Amiens and the count of Saint-Pol", "Flanders turns back, then rejoins", "Alexios III retires")
source_refs = PackedStringArray("Clari 45-48 (De Re Militari): Peter of Amiens and the count of Saint-Pol; grooms and cooks with \"copper pots and with pestles\"; they will not \"turn back one step\"; the ladies at the windows: \"it seemed as if our warriors were angels\" (47); Flanders rejoins (48) — quoted per docs/STORY-SOURCES.md", "Villehardouin pp. 43-45: Alexios III retires without attacking", "docs/STORY-SOURCES.md \"Period words\": IN GOD'S NAME (AT A WALK)", "docs/STORY.md 7.3", "src/campaign/chapters/ch7.ts 7.3 (draft reference)")
review_status = "draft_implemented_review_pending"
