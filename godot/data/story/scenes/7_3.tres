[resource]
script = ExtResource("1_storyscenedata")
id = "7.3"
content_version = 1
title = "Stay beside Pierre"
old_title = "Stay beside Pierre"
level = 7
summary = "BAGNASKIZ WEARS THE FACE OF THE EMPEROR ALEXIOS III. THE COUNT OF FLANDERS TURNS BACK. PIERRE AND THE COUNT OF SAINT-POL GO ON AT A WALK, AND EVEN THE COOKS COME OUT WITH POTS AND PESTLES. HOLD LEVEL WITH PIERRE'S SHOULDER. HIGH ON THE WALLS A WOMAN WITH SANTINA'S FACE IS WATCHING; THE WIND TAKES WHAT SHE SAYS. THE EMPEROR TURNS FOR THE CITY. NOBODY STRIKES A BLOW."
map = "field"
music = "medieval"
cast = PackedStringArray("zampano", "emperor", "knight", "sbrimbrulon")
steps = [SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29"), SubResource("Resource_30")]
entry_conditions = {
"requires_completed": ["7.2"]
}
