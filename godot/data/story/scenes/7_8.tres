[sub_resource type="Resource" id="Resource_21"]
script = ExtResource("10_narrationstep")
id = "s12"
text = "NIKETAS'S HOUSE BURNED IN THE FIRE; HE AND HIS FRIENDS HAVE SHELTERED IN ONE WITH A DARK ENTRANCE, AND THE LAMP CAME WITH THEM. NOW THE HOUSEHOLD IS LEAVING ON FOOT, A VENETIAN FRIEND IN FRONT, THE GIRLS IN THE MIDDLE WITH MUD ON THEIR FACES. JACK DRAGS ONE OF THEM OUT OF THE GROUP."

