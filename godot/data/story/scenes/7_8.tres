[resource]
script = ExtResource("1_storyscenedata")
id = "7.8"
content_version = 1
title = "Whose street was it?"
old_title = "Whose street was it?"
level = 7
summary = "THE CITY IS TAKEN. THE SMALL KNIGHT WILL WRITE THAT NO MISCHIEF WAS DONE, AND FILL HIS BOOK WITH WONDERS. TURN THE PAGE: THE SAME STREETS AS NIKETAS WILL WRITE THEM, AND HIS OWN DOORWAY. HIS HOUSEHOLD IS LEAVING; JACK DRAGS A GIRL OUT OF THE GROUP. WAIT FOR A LULL AND CALL THE PILGRIMS TO THEIR OATH, OR STAND SILENT WHILE NIKETAS CALLS THEM HIMSELF. EITHER WAY THEY LET HER GO."
map = "city"
music = "medieval"
cast = PackedStringArray("zampano", "niketas", "jack", "knight")
steps = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_30"), SubResource("Resource_31"), SubResource("Resource_32"), SubResource("Resource_33")]
entry_conditions = {
"requires_completed": ["7.7"]
}
persistent_effects = PackedStringArray("flags.oath", "book.marvels", "meter.commozione", "meter.supervillain", "meter.grace", "meter.standing", "book.values", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["oath"]
}
reality = false
historical_tags = PackedStringArray("dream", "the sack, April 1204", "two accounts side by side", "Niketas's flight", "the oath recalled", "decides the ending")
source_refs = PackedStringArray("Clari 80: the taking; \"no mischief was done to poor or to rich\" (quoted per docs/STORY-SOURCES.md)", "Choniates, the sack (Munro pp. 15-16): the Great Church; \"No one was without a share in the grief\" (quoted per docs/STORY-SOURCES.md)", "Barbero's lecture, after Niketas: the house with a dark entrance, the Venetian friend, the girls with mud on their faces, a girl dragged away and let go when the oath is recalled", "docs/STORY.md 7.8", "src/campaign/chapters/ch7.ts 7.8 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "Zampano's call and Jack's role are invented.", "Decides the ending: calling the oath in a lull (Commozione 5, or all he has left) sets oath=enforced (THE KNIGHT); 16 s of silence and Niketas calls it himself, oath=silent (THE WITNESS, ending key alpha).", "Niketas's last line is the game's, not a quotation.")
technical_status = "technically_complete"
