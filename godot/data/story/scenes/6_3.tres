[resource]
script = ExtResource("1_storyscenedata")
id = "6.3"
content_version = 1
title = "On their knees at Corfu"
old_title = "On their knees at Corfu"
level = 6
summary = "AT CORFU THE YOUNG ALEXIOS JOINS THE FLEET IN PERSON. HALF THE HOST WANTS TO STAY ON THE ISLAND AND SEND FOR SHIPS TO SYRIA, AND PIERRE IS ONE OF THEM. FOLLOW HIS LORD TO THE OTHER CAMP. THE LEADERS COME AND KNEEL IN FRONT OF THEM, WEEPING. TELL PIERRE WHAT YOU THINK; HE DECIDES. THE FLEET SAILS FOR CONSTANTINOPLE."
map = "island"
music = "medieval"
