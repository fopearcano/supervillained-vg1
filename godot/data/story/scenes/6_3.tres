source_refs = PackedStringArray("Villehardouin pp. 27-30: young Alexius joins at Corfu; more than half the host, Peter of Amiens among them, means to stay; the chiefs go on their knees; a covenant until Michaelmas; sailing on the eve of Pentecost 1203", "Clari 31-33: \"Bah! What have we to do in Constantinople?\" (quoted per docs/STORY-SOURCES.md)", "Clari 39: the bishops call it \"a good work of great merit\"", "docs/STORY.md 6.3", "src/campaign/chapters/ch6.ts 6.3 (draft reference)")
