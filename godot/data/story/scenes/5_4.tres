source_refs = PackedStringArray("Villehardouin pp. 26-27: envoys to Rome; the pope absolves the pilgrims", "Clari 15: letters \"whereby all the pilgrims and all the Venetians were absolved\" (quoted per docs/STORY-SOURCES.md)", "docs/STORY-SOURCES.md \"Kept disagreements\"", "docs/STORY.md 5.4", "src/campaign/chapters/ch5.ts 5.4 (draft reference)")
