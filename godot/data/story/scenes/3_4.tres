[resource]
script = ExtResource("1_storyscenedata")
id = "3.4"
content_version = 1
title = "Nobody leaves the Lido"
old_title = "Nobody leaves the Lido"
level = 3
summary = "THE DOGE WANTS HIS MONEY, AND THE ARMY IS KEPT ON THE ISLAND. A BREAD SELLER STILL SLIPS BETWEEN THE TENTS: FOLLOW HIM UNSEEN TO THE COUNCIL'S AWNING (A GUARD WATCHES; BUSHES HIDE YOU) AND OVERHEAR WHAT THE LEADERS DECIDE. WINTER IS COMING, AND A CITY CALLED ZARA WILL PAY FOR THE DELAY. NOBODY TELLS THE ARMY. THE OLD, BLIND DOGE TAKES THE CROSS."
map = "lido"
music = "level3"
cast = PackedStringArray("zampano", "doge")
steps = [SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27")]
entry_conditions = {
"requires_completed": ["3.3"]
}
persistent_effects = PackedStringArray("flags.zaraDeal", "book.remembered")
completion = {
"boundary": "chapter_end",
"requires_flags": ["zaraDeal"]
}
reality = false
historical_tags = PackedStringArray("dream", "the Lido (the isle of Saint Nicholas), 1202", "the food threatened", "the Zara deal, kept from the army", "the Doge takes the cross at Saint Mark's")
source_refs = PackedStringArray("Clari 10-13 (De Re Militari; XI-XIII in Munro): the island; the Doge demands the sum and threatens the food, which still comes; winter; Zara; \"No one in the army knew this plan, except the leaders\" (Clari XIII, quoted per docs/STORY-SOURCES.md)", "Villehardouin pp. 16-17: Zara, held by the king of Hungary; the Doge takes the cross, sewn on \"a great cotton hat\" (p. 17)", "docs/STORY.md 3.4", "src/campaign/chapters/ch3.ts 3.4 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The bread seller, the guard, the bushes and the overheard fragments are adaptation.", "REVIEW REQUIRED: the card \"WINTER IS COMING. TAKE BACK ZARA FOR VENICE, AND THE DEBT CAN WAIT.\" paraphrases the proposal (Clari XIII; Villehardouin p. 16); it is not a quotation.", "The card \"NOBODY IN THE ARMY KNOWS THE PLAN, EXCEPT THE LEADERS\" paraphrases Clari XIII.")
technical_status = "technically_complete"
