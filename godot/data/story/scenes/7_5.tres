[resource]
script = ExtResource("1_storyscenedata")
id = "7.5"
content_version = 1
title = "Unpaid promises"
old_title = "Unpaid promises"
level = 7
summary = "THE FIRST PAYMENT COMES; THE REST DOES NOT. CARRY THE CHESTS OUT OF THE PALACE: EACH ONE LIGHTER. THE DOGE TELLS THE YOUNG EMPEROR WHAT HE THINKS OF HIM. THEN SOME PILGRIMS GO TO BURN THE MOSQUE OF THE CITY'S MUSLIMS, THEIR GREEK NEIGHBOURS DEFEND IT, AND A FIRE STARTS THAT BURNS FOR TWO DAYS. LEAD A WOMAN OF NIKETAS'S HOUSEHOLD HOME ALONG THE STREET YOU LEARNED. SHE TELLS HIM NOT TO COME BACK."
map = "city"
music = "medieval"
cast = PackedStringArray("zampano", "doge", "householdWoman")
steps = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22")]
entry_conditions = {
"requires_completed": ["7.4"]
}
persistent_effects = PackedStringArray("book.remembered")
completion = {
"boundary": "scene"
}
reality = false
historical_tags = PackedStringArray("dream", "Constantinople, autumn 1203", "the unpaid sums", "the mosque and the great fire", "division between the Greeks and the Franks")
source_refs = PackedStringArray("Clari LVI and LIX (Munro): a first payment, then no more; the Doge rebukes the young emperor (paraphrased, per docs/STORY-SOURCES.md)", "Villehardouin pp. 48-53: Alexius cannot pay; the riot and the fire of two days; \"Thus was there division between the Greeks and the Franks\" (pp. 51-52, quoted per docs/STORY-SOURCES.md)", "Barbero's lecture on the Fourth Crusade: the mosque, the Greeks defending their Muslim neighbours, the fire; Niketas loses his house", "docs/STORY.md 7.5", "src/campaign/chapters/ch7.ts 7.5 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "REVIEW REQUIRED (OQ-07): the mosque and the fire. 7.5 follows Barbero's lecture (pilgrims set out to burn the mosque, Greeks defend their Muslim neighbours, the fire); docs/STORY.md 7.4 omits it. The contradiction stays open.", "The chests, the woman and the walk home are adaptation; the fire is a walk with safe checkpoints (WALK-019-021). The smoke (three burns) sends him back to the last checkpoint; nothing persists before the scene completes.")
technical_status = "technically_complete"
