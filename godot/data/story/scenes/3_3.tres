[resource]
script = ExtResource("1_storyscenedata")
id = "3.3"
content_version = 1
title = "The art of weeping"
old_title = "The art of weeping"
level = 3
summary = "THE MARSHAL TELLS HOW THE ENVOYS WON OVER THE VENETIANS A YEAR EARLIER, IN 1201. ZAMPANO WAS NOT THERE, SO HE PLAYS IT AS HE IS TOLD: TAKE THE MARSHAL'S PLACE AT THE FRONT, KNEEL, WAIT FOR THE SQUARE TO FALL QUIET, THEN WEEP. ONE VENETIAN IS MOVED, THEN HIS NEIGHBOUR, THEN THE WHOLE SQUARE. THE MEMORY ENDS ON THE ISLAND, WITH THE BILL."
map = "venice"
music = "level3"
cast = PackedStringArray("zampano", "marshal")
steps = [SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21")]
entry_conditions = {
"requires_completed": ["3.2"]
}
persistent_effects = PackedStringArray("meter.commozione", "flags.weptWell", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["weptWell"]
}
reality = false
historical_tags = PackedStringArray("dream", "Saint Mark's, Venice, 1201 (a recollection)", "the envoys' plea", "the people answer")
source_refs = PackedStringArray("Villehardouin pp. 7-8: the envoys ask the council, then the people at Saint Mark's; \"knelt at the feet of the people, weeping many tears\" (p. 8, quoted per docs/STORY-SOURCES.md)", "docs/STORY-SOURCES.md \"Period words\": IN THRALL TO THE TURKS, OUTREMER", "docs/STORY.md 3.3", "src/campaign/chapters/ch3.ts 3.3 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "Played as the marshal's recollection, not as something Zampano saw; the trumpets and the spreading tears are adaptation.", "The weeping is a story interaction (the lull); the unused weeping() minigame of the draft is not restored.")
technical_status = "technically_complete"
