[resource]
script = ExtResource("1_storyscenedata")
id = "7.2"
content_version = 1
title = "The Doge's banner"
old_title = "The Doge's banner"
level = 7
summary = "17 JULY 1203, AT THE SEA WALLS. THE OLD, BLIND DOGE HAS HIMSELF PUT ASHORE WITH THE BANNER OF SAINT MARK. FOLLOW IT THROUGH THE LANDING WHILE AXE-BEARING GUARDS APPEAR AT THE PARAPET. THEY COME DOWN: HOLD YOUR GROUND BY THE BANNER, SHIELD UP, UNTIL THE VENETIANS HOLD THE TOWERS. THEN CARRY WORD TO THE LANDWARD CAMP: THE EMPEROR HAS COME OUT WITH A MUCH LARGER FORCE."
map = "field"
music = "medieval"
cast = PackedStringArray("zampano", "doge", "marshal")
steps = [SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18"), SubResource("Resource_19"), SubResource("Resource_20"), SubResource("Resource_21"), SubResource("Resource_22"), SubResource("Resource_23"), SubResource("Resource_24")]
entry_conditions = {
"requires_completed": ["7.1"]
}
persistent_effects = PackedStringArray("book.remembered")
completion = {
"boundary": "scene"
}
reality = false
historical_tags = PackedStringArray("dream", "the assault of 17 July 1203", "the Doge and the banner of Saint Mark", "the axe-bearing guard", "Alexios III comes out")
source_refs = PackedStringArray("Villehardouin pp. 41-45: the assault of 17 July; the Doge lands with the standard of Saint Mark (\"more than forty people told him\", quoted per docs/STORY-SOURCES.md); the Venetians take towers; Alexios III comes out", "Clari 44 and 46: his estimate of the emperor's horsemen (a claim)", "docs/STORY.md 7.2", "src/campaign/chapters/ch7.ts 7.2 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The stand by the banner against the axe-men is adaptation: a timed hold (18 s) in a fight that need rout nobody; a knockdown starts the hold again.", "\"A HUNDRED THOUSAND HORSEMEN\" is Clari's own figure, given as his (a claim).")
technical_status = "technically_complete"
