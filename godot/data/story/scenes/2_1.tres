[resource]
script = ExtResource("1_storyscenedata")
id = "2.1"
content_version = 1
title = "One step from Jerusalem"
old_title = "One step from Jerusalem"
level = 2
summary = "UNDER THE DESK THE DARK OPENS INTO A PALE COUNTRY. ON THE SKYLINE STANDS JERUSALEM, THE CITY EVERY PREACHER NAMES. HE WEARS A COAT OF MAIL NOW, AND A HELMET MUCH TOO BIG FOR HIM. WALK TO THE GATE: IT KEEPS STEPPING BACK, AND BEHIND A DOOR SOMEONE NAMES ANOTHER PLACE."
map = "jerusalem"
music = "level2"
cast = PackedStringArray("zampano", "professor")
steps = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13")]
entry_conditions = {
"requires_completed": ["1.5"]
}
persistent_effects = PackedStringArray("book.remembered")
completion = {
"boundary": "scene"
}
reality = false
historical_tags = PackedStringArray("dream", "the dream begins (the sleep boundary of 1.5)", "Jerusalem as the preached destination, never reached", "the leaders' objective: Babylon, that is Egypt (Villehardouin p. 8), heard behind a door")
source_refs = PackedStringArray("Villehardouin p. 8 (the council knew the objective was Babylon, Egypt; the people were told only \"overseas\"; attested per docs/STORY-SOURCES.md)", "Clari XIII (Munro): only the leaders knew the plan", "docs/STORY.md 2.1", "src/campaign/chapters/ch2.ts 2.1 (draft reference)", "STORY_CONTENT_MATRIX.md 2.1")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01: prototype deferral, not approval).", "The dream prologue is adaptation: the receding gate and the helmet (the bucket of 1.1) are invented images.", "Jerusalem is presented only as the preached destination; the line behind the door carries the leaders' objective (Babylon, Egypt) and is source-tagged (Villehardouin p. 8). Jerusalem is never said to be the leaders' operative target.", "REVIEW REQUIRED: the door line's \"BABYLON FIRST\" compresses Villehardouin p. 8 (the decision taken in council at Venice); confirm the wording or move it to the Professor.")
technical_status = "technically_complete"
