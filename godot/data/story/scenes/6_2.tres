[resource]
script = ExtResource("1_storyscenedata")
id = "6.2"
content_version = 1
title = "A prince on credit"
old_title = "A prince on credit"
level = 6
summary = "FOLLOW THE TALK OF THE MARQUIS'S GUESTS FROM THE COOK TO THE COUNCIL TENT. PIECE TOGETHER THE OFFER BROUGHT BY KING PHILIP'S ENVOYS: YOUNG ALEXIOS, SON OF THE DEPOSED ISAAC II, WILL PAY TWO HUNDRED THOUSAND MARKS, FEED THE HOST, SEND MEN TO EGYPT AND PUT THE GREEK CHURCH UNDER ROME, IF THEY HELP HIM TAKE BACK CONSTANTINOPLE. THE LEADERS SAY YES."
map = "winter"
music = "medieval"
cast = PackedStringArray("zampano", "cook", "marshal")
steps = [SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14")]
