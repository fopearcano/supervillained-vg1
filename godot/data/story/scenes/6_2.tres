source_refs = PackedStringArray("Villehardouin pp. 23-25: the envoys of King Philip; the offer (obedience to Rome, 200,000 marks, food for a year, 10,000 men for a year, 500 knights for life); the debate; only twelve swear for the Franks", "Clari XVII (Munro): Boniface had met the young man at Philip's court", "docs/STORY-SOURCES.md \"Period words\": THE LOMBARD", "docs/STORY.md 6.2", "src/campaign/chapters/ch6.ts 6.2 (draft reference)")
review_status = "draft_implemented_review_pending"
