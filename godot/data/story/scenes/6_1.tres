old_title = "Short rations"
level = 6
summary = "WINTER QUARTERS. TAKE THE DAY'S RATIONS ROUND THE TENTS: HALF A LOAF EACH, AND A SHIP LEAVING FOR SYRIA WITH MEN WHO SWORE TO STAY. AT THE LAST TENT ALEAUME IS SHIVERING WITH NOTHING IN HIS HANDS, AND JACK IS CALLING EVERYONE TO THE DICE. SHARE YOUR OWN HALF LOAF, OR GO AND PLAY."
map = "winter"
music = "medieval"
cast = PackedStringArray("zampano", "confusione", "jack")
steps = [SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28"), SubResource("Resource_29")]
