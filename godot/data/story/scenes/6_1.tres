}
reality = false
historical_tags = PackedStringArray("dream", "Zara, winter 1202-1203", "desertions; a ship to Syria", "the poor knights and the rich men")
source_refs = PackedStringArray("Villehardouin pp. 25-26 (desertions over the winter; a ship sent to Syria, an oath broken)", "Clari 16 / XVI (the winter at Zara; no money or food to reach Babylon or Alexandria)", "docs/STORY-SOURCES.md \"Period words\": LI RIKE HOMME, LI POVRE CHEVALIER", "docs/STORY.md 6.1", "src/campaign/chapters/ch6.ts 6.1 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The rations, the dice and the shared bread are adaptation: they set up `comradeship`, read back at the breach (7.7).", "Sharing costs 8 Commozione and gives the value COMRADESHIP; the dice set `comradeship` false.")
