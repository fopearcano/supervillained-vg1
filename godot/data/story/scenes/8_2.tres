[resource]
script = ExtResource("1_storyscenedata")
id = "8.2"
content_version = 1
title = "What he can tell"
old_title = "What he can tell"
level = 8
summary = "UNDER THE DESK THE ARMOUR IS A RAG AGAIN, AND NOTHING CAME BACK WITH HIM. LOOK AROUND THE STUDY: THE CHAIR LEG, THE LAMPSHADE, THE RUG AND THE DESK LAMP ARE ONLY THEMSELVES, UNLESS HE SAW WHAT THE DREAM MADE OF THEM. CONFUSIONE WANTS THE STORY FROM THE BEGINNING. TELL THE OATH THE WAY IT HAPPENED, THEN LEAVE ONE DRAWING UNDER THE DESK."
map = "study"
music = "greenzone"
cast = PackedStringArray("zampano", "professor", "confusione")
steps = [SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_21"), SubResource("Resource_26"), SubResource("Resource_31"), SubResource("Resource_36"), SubResource("Resource_37"), SubResource("Resource_46"), SubResource("Resource_47"), SubResource("Resource_48"), SubResource("Resource_49"), SubResource("Resource_50"), SubResource("Resource_51")]
entry_conditions = {
"requires_completed": ["8.1"]
}
persistent_effects = PackedStringArray("book.items", "meter.commozione", "flags.told", "flags.drawing", "flags.tellingTier", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["told", "drawing", "tellingTier"]
}
reality = true
historical_tags = PackedStringArray("reality", "what he can tell", "the study", "the strict truth")
source_refs = PackedStringArray("Adaptation, replacing the old relic altar and chapel: ordinary objects, memories and a drawing; nothing medieval comes into reality", "Meraviglia's marvels map to the study's objects (src/campaign/home.ts, the marvel -> home mapping)", "Clari 120: his claim to have told \"the strict truth\" (quoted per docs/STORY-SOURCES.md)", "docs/STORY.md 8.2", "src/campaign/chapters/ch8.ts 8.2 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "REVIEW REQUIRED: the Professor's \"HOME TO PICARDY\" (as OQ-09).", "REVIEW REQUIRED: the letter readback (5.4's `letter`) is new to the Godot rewrite; the draft has none.", "A study object is what the dream made of it only if he saw that marvel; the drawings are locked unless he saw them; the bowl is always open.")
technical_status = "technically_complete"
