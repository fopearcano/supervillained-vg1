[resource]
script = ExtResource("1_storyscenedata")
id = "7.7"
content_version = 1
title = "The hole in the wall"
old_title = "The hole in the wall"
level = 7
summary = "BEFORE THE ASSAULT EVERYONE SWEARS: EVERYTHING TAKEN IS BROUGHT IN AND DECLARED, AND NO HAND ON WOMEN OR CLERGY. THE FRIDAY ASSAULT FAILS AND THE WALLS MOCK THEM. ON THE MONDAY PIERRE'S MEN HACK A HOLE IN A WALLED-UP GATE AND NOBODY DARES GO IN. ALEAUME DOES. HOLD HIM BACK BY THE FOOT: HE WRIGGLES FREE. FOLLOW HIM IN."
map = "breach"
music = "medieval"
cast = PackedStringArray("zampano", "bishop", "jack", "confusione")
steps = [SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_12"), SubResource("Resource_13"), SubResource("Resource_14"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_23"), SubResource("Resource_24"), SubResource("Resource_25"), SubResource("Resource_26"), SubResource("Resource_27"), SubResource("Resource_28")]
entry_conditions = {
"requires_completed": ["7.6"]
}
persistent_effects = PackedStringArray("meter.grace", "flags.sworn", "meter.commozione", "meter.supervillain", "book.values", "flags.followed", "book.remembered")
completion = {
"boundary": "scene",
"requires_flags": ["sworn", "followed"]
}
reality = false
historical_tags = PackedStringArray("dream", "April 1204", "the oath before the assault", "the failed Friday", "the breach at the walled-up gate", "Aleaume of Clari")
source_refs = PackedStringArray("Clari 68 (the agreement: booty declared under oath, women and clergy protected), 70-71 (the Friday assault fails; the mockery), 72-73 (absolution; the women sent away), 75-76 (Pierre at the walled-up postern; Aleaume goes in on hands and feet while his brother holds him by the foot), 77-79", "Villehardouin pp. 59-63: the covenant; the assaults; 12 April 1204", "docs/STORY.md 7.7", "src/campaign/chapters/ch7.ts 7.7 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "Confusione plays Aleaume; the deed is Aleaume's, not Zampano's.", "The tug is lost by design (MINI-010): Commozione +6 once; the scene goes on once.", "With comradeship (6.1) his voice guides; without it only the rattle of his mail (a goal found by ear).")
technical_status = "technically_complete"
