title = "Look at those ships"
old_title = "Look at those ships"
level = 3
summary = "WALK THE QUAY BEHIND PIERRE WHILE THE HARBOUR BELL CLANGS LIKE THE BOWL AT HOME. LOOK AT THE GREAT SHIPS, THE GALLEYS AND THE TRANSPORTS WITH A DOOR IN THE SIDE FOR THE HORSES: MERAVIGLIA, HIS BOOK OF MARVELS, OPENS. THEN TURN ROUND AND COUNT THE EMPTY BERTHS."
map = "venice"
music = "level3"
cast = PackedStringArray("zampano", "sbrimbrulon")
steps = [SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_8"), SubResource("Resource_9"), SubResource("Resource_10"), SubResource("Resource_11"), SubResource("Resource_15"), SubResource("Resource_16"), SubResource("Resource_17"), SubResource("Resource_18")]
