historical_tags = PackedStringArray("dream", "Venice, summer 1202", "the fleet ready, the army short", "the horse transports (uissiers)")
source_refs = PackedStringArray("Clari XI (Munro): far fewer came than the fleet was built for (his numbers are a claim)", "Clari 13: each high man has \"his own transport to carry his horses\" (quoted per docs/STORY-SOURCES.md)", "Villehardouin pp. 13-16: many sailed from other ports", "docs/STORY-SOURCES.md \"Period words\": DROMONS, UISSIERS", "docs/STORY.md 3.1", "src/campaign/chapters/ch3.ts 3.1 (draft reference)")
review_status = "draft_implemented_review_pending"
review_notes = PackedStringArray("Draft implemented; narrative review pending (OD-01).", "The door in the hull described as the horses going in on foot, and the bell that clangs like the bowl, are adaptation.", "Meraviglia (the book of marvels) opens here: three marvels, each awarded once.")
technical_status = "technically_complete"
