[gd_resource type="Resource" script_class="ShellText" format=3]

[ext_resource type="Script" path="res://core/resources/shell_text.gd" id="1_shelltext"]

[resource]
script = ExtResource("1_shelltext")
strings = {
"boundary_body": "THIS SCENE IS NOT IN THIS BUILD YET: THE STORY SCENES ARRIVE WITH A LATER MILESTONE.",
"boundary_saved": "YOUR PROGRESS IS SAVED.",
"boundary_title": "NOT IN THIS BUILD",
"book_body": "THE MERAVIGLIA BOOK OPENS WITH THE STORY SCENES, IN A LATER MILESTONE.",
"costume_cross": "RAG CROSS",
"costume_knight": "ARMOUR",
"costume_none": "NONE",
"edition": "CRUSADER",
"ending_alpha": "THE WITNESS",
"ending_counts": "VALUES: %d  MARVELS: %d",
"ending_grace_high": "HE KEPT THE FORMS HE SWORE TO, EVEN THE SMALL ONES NOBODY CHECKS.",
"ending_grace_low": "HE BROKE THE FORMS HE SWORE TO, AND EVERY AUTHORITY FORGAVE HIM. HE HAS NOT QUITE FORGIVEN HIMSELF.",
"ending_grace_mid": "HE KEPT MOST OF THE FORMS HE SWORE TO. ABOUT THE REST HE HAS A LONG EXPLANATION.",
"ending_knight": "THE KNIGHT",
"ending_meters": "SUPERVILLAIN %d  GRACE %d",
"ending_standing_fair": "THE CAMP REMEMBERS HIM, MORE OR LESS.",
"ending_standing_fond": "THE CAMP REMEMBERS HIM FONDLY. THE DOGS AT THE FENCES WATCH HIM DRINK AND SAY NOTHING.",
"ending_standing_low": "THE MARSHAL REMEMBERS WHO SPOKE AGAINST HIM. HE WALKED ON ANYWAY.",
"ending_story_alpha": "HE STOOD SILENT WHILE NIKETAS CALLED THE PILGRIMS TO THEIR OATH, AND UNDER THE DESK HE GAVE THE LINE BACK TO ITS OWNER. ON THE LAWN BAGNASKIZ STEPPED ASIDE ANYWAY, AND THE LANE STAYED OPEN. THE GIRL IS WITH HER FAMILY EITHER WAY; WHAT DIFFERS IS THE STORY HE CAN HONESTLY TELL.",
"ending_story_knight": "IN A LULL IN THE LOOTING HE CALLED THE PILGRIMS TO THEIR OATH, IN HIS OWN WORDS, AND UNDER THE DESK HE TOLD IT THAT WAY. ON THE LAWN BAGNASKIZ STEPPED ASIDE AND THE LANE STAYED OPEN. ZAMPANO DID NOT BECOME A HERO: HE WAS A SMALL KNIGHT WHO SAID ONE TRUE THING AT THE RIGHT MOMENT, AND HE IS TOO THICK-HEADED TO STOP SAYING IT.",
"ending_the_end": "THE END",
"levels_subtitle": "SUPERVILLAINED: CRUSADER",
"meter_commozione": "COMMOZIONE",
"meter_grace": "GRACE",
"meter_standing": "STANDING",
"meter_supervillain": "SUPERVILLAIN",
"notice_body": "ZAMPANO NOW DREAMS ONE STORY: THE FOURTH CRUSADE, FROM VENICE TO CONSTANTINOPLE, AS A SMALL KNIGHT SEES IT. YOUR WALK IN THE GREEN ZONE AND THE NEIGHBORHOOD SCENES YOU PLAYED ARE KEPT, WITH YOUR COINS AND PLAY TIME. THE STORY STARTS AGAIN FROM 1.1, WITH FRESH METERS, BOOK AND COSTUMES.",
"notice_foot": "YOUR OLD SAVE IS KEPT ASIDE, UNTOUCHED.",
"notice_title": "THE DREAM HAS BEEN REWRITTEN",
